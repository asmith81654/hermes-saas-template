# =============================================================================
# Hermes Agent Railway SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before deploying.
# Sensitive values (API keys, bot tokens) are auto-redacted in the dashboard.
#
# Usage:
#   1. Copy:  cp .env.example .env
#   2. Edit:  vim .env
#   3. Deploy: ./scripts/full-deploy.sh --user-id user-001 --config .env
# =============================================================================

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# IMPORTANT: Change ADMIN_PASSWORD! A random password is generated if left empty,
# but you should set a strong one. This protects the web dashboard.

# ── Default Agent Configuration ───────────────────────────────────────────────
# These env vars define the agent that each user starts with.
# They are injected by the inject-config.sh script after Railway deployment.

HERMES_DEFAULT_AGENT_NAME=通用助手
HERMES_DEFAULT_AGENT_SYSTEM_PROMPT=你是一個友善、專業的 AI 助手，由 Hermes Agent 驅動。你擅長回答問題、提供建議、協助寫作、分析數據和完成各種任務。你可以使用工具來增強你的能力。請用用戶使用的語言回應。
HERMES_DEFAULT_AGENT_MODEL=openrouter/anthropic/claude-sonnet-4.6
HERMES_DEFAULT_AGENT_TOOLS=

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# At least one provider must be configured for the agent to function.

# OpenRouter (recommended — single key, 200+ models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Google AI Studio (Gemini models)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (ultra-fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# xAI (Grok models)
# Get your key at: https://x.ai/api
XAI_API_KEY=

# Together AI
# Get your key at: https://api.together.xyz/
TOGETHER_API_KEY=

# Mistral AI
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=

# Cohere
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Perplexity
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Messaging Channels ────────────────────────────────────────────────────────

# Telegram Bot — Chat with @BotFather to create
TELEGRAM_BOT_TOKEN=

# Slack App — https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Discord Bot — https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# WhatsApp Cloud API — https://developers.facebook.com/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Microsoft Teams — https://portal.azure.com → App registrations
MSTEAMS_CLIENT_ID=
MSTEAMS_CLIENT_SECRET=
MSTEAMS_TENANT_ID=

# Google Chat — https://console.cloud.google.com/
GOOGLE_CHAT_PROJECT_ID=

# Matrix — https://matrix.org/
MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_ACCESS_TOKEN=

# Twitter/X — https://developer.x.com/
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Gateway Configuration ─────────────────────────────────────────────────────
GATEWAY_AUTO_START=true
GATEWAY_LOG_BUFFER_SIZE=2000

# ── Pairing Configuration ─────────────────────────────────────────────────────
PAIRING_LINK_TTL=86400

# ── Paths (usually not changed) ───────────────────────────────────────────────
# HOME=/data
# HERMES_HOME=/data/.hermes
